PROJECT_NAME           = "EEVS (Enhanced External Voice Server)"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "High-performance external voice server and C++ Plugin SDK for FiveM Enhanced"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs"
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"
STRIP_FROM_INC_PATH    = "@PROJECT_SOURCE_DIR@/include"

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES

INPUT                  = "@PROJECT_SOURCE_DIR@/include" \
                         "@PROJECT_SOURCE_DIR@/src/core" \
                         "@PROJECT_SOURCE_DIR@/src/audio" \
                         "@PROJECT_SOURCE_DIR@/src/network" \
                         "@PROJECT_SOURCE_DIR@/src/plugins"
FILE_PATTERNS          = *.h \
                         *.hpp
RECURSIVE              = YES
EXCLUDE                = "@PROJECT_SOURCE_DIR@/src/network/enet.h"

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
CLASS_DIAGRAMS         = YES
HAVE_DOT               = @DOXYGEN_DOT_FOUND@
